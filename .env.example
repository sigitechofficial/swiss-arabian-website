# Swiss Arabian storefront — local env
# Copy to .env.local and fill in values.

# Values: local | dev | staging | production
NEXT_PUBLIC_APP_ENV=dev

# true  → LOCAL_API_BASE_URL regardless of APP_ENV
# false → API_BASE_BY_ENV[APP_ENV]
NEXT_PUBLIC_USE_LOCAL_API=false

# API bases (per env) — no trailing slash
NEXT_PUBLIC_LOCAL_API_BASE_URL=http://192.168.18.143:3000
NEXT_PUBLIC_DEV_API_BASE_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io
NEXT_PUBLIC_STAGING_API_BASE_URL=
NEXT_PUBLIC_PRODUCTION_API_BASE_URL=

# Return / redirect URLs (OAuth + payment callbacks)
NEXT_PUBLIC_LOCAL_RETURN_URL=http://localhost:3000
NEXT_PUBLIC_DEV_RETURN_URL=http://localhost:3000
NEXT_PUBLIC_STAGING_RETURN_URL=
NEXT_PUBLIC_PRODUCTION_RETURN_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_MFA=false
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true
NEXT_PUBLIC_CUSTOMER_VERIFICATION_UI=true
NEXT_PUBLIC_ENABLE_OAUTH=false
NEXT_PUBLIC_USE_DEV_SESSION=false

# Local QA only — never set against a production build
# NEXT_PUBLIC_CUSTOMER_MASTER_OTP=

# Google Maps (store locator + Places address autocomplete)
# Enable Maps JavaScript API and Places API on the key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional override for relative catalog images (`/catalog/media/...`).
# Leave empty → falls back to apiBaseUrl.
# NEXT_PUBLIC_CATALOG_MEDIA_BASE_URL=

# Brand layer (Sapil). Host only — no scheme, path, or port.
# Local: add `127.0.0.1 sapil.test` to hosts and browse http://sapil.test:<port>
# NEXT_PUBLIC_STOREFRONT_HOST=sapil.test
# NEXT_PUBLIC_STOREFRONT_BRAND_CODE=SAPIL

# OpenAPI codegen (build script, not browser)
# OPENAPI_SPEC_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io/api/docs-json
