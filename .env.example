# Swiss Arabian Website — local env

# true  → http://192.168.18.143:3000 (LAN)
# false → Azure Dev
NEXT_PUBLIC_USE_LOCAL_API=false

NEXT_PUBLIC_APP_ENV=dev

# API bases (per env) — no trailing slash
NEXT_PUBLIC_LOCAL_API_BASE_URL=http://192.168.18.143:3000
NEXT_PUBLIC_DEV_API_BASE_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io
NEXT_PUBLIC_STAGING_API_BASE_URL=
NEXT_PUBLIC_PRODUCTION_API_BASE_URL=

# Return URLs
NEXT_PUBLIC_LOCAL_RETURN_URL=http://localhost:3000
NEXT_PUBLIC_DEV_RETURN_URL=https://ca-swissarabian-website-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io
NEXT_PUBLIC_STAGING_RETURN_URL=
NEXT_PUBLIC_PRODUCTION_RETURN_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_MFA=false
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true
# Optional phone-verify page chrome (Phase 1). Register stays non-blocking in 1B.
NEXT_PUBLIC_CUSTOMER_VERIFICATION_UI=false
NEXT_PUBLIC_ENABLE_OAUTH=false
# Prefer Paymob hosted checkout when the zone offers it (set false to use backend default)
NEXT_PUBLIC_ENABLE_PAYMOB=true
NEXT_PUBLIC_USE_DEV_SESSION=false

# Local QA only when backend CUSTOMER_MASTER_OTP_ENABLED=true — never ship to prod API
# NEXT_PUBLIC_CUSTOMER_MASTER_OTP=000000

# Google Maps (store locator) — Maps JavaScript API + (optional) Map ID for Advanced Markers
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional override for relative catalog images (`/catalog/media/...`).
# Defaults to the active API base when unset.
# NEXT_PUBLIC_CATALOG_MEDIA_BASE_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io

# Insider CRM — Web SDK only (account ID from CRM / Insider panel).
# Events are skipped when ENABLED=false or ACCOUNT_ID is empty.
# NEXT_PUBLIC_INSIDER_ENABLED=true
# NEXT_PUBLIC_INSIDER_ACCOUNT_ID=
# NEXT_PUBLIC_INSIDER_SCRIPT_HOST=swissarabian.api.useinsider.com

# OpenAPI (optional)
# OPENAPI_SPEC_URL=http://localhost:4000/swagger/json
