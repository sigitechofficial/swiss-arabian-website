# Swiss Arabian storefront — local env
# Copy to .env.local and fill in values.

# Values: local | dev | staging | production
NEXT_PUBLIC_APP_ENV=dev

# true  → LOCAL_API_BASE_URL regardless of APP_ENV
# false → API_BASE_BY_ENV[APP_ENV]
NEXT_PUBLIC_USE_LOCAL_API=true

# API bases (per env) — no trailing slash
NEXT_PUBLIC_LOCAL_API_BASE_URL=http://192.168.18.33:3000
#NEXT_PUBLIC_DEV_API_BASE_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io
NEXT_PUBLIC_STAGING_API_BASE_URL=
NEXT_PUBLIC_PRODUCTION_API_BASE_URL=

# Return / redirect URLs (OAuth + payment callbacks)
NEXT_PUBLIC_LOCAL_RETURN_URL=http://localhost:3004
NEXT_PUBLIC_DEV_RETURN_URL=http://localhost:3004
NEXT_PUBLIC_STAGING_RETURN_URL=
NEXT_PUBLIC_PRODUCTION_RETURN_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_MFA=false
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true
NEXT_PUBLIC_CUSTOMER_VERIFICATION_UI=true
NEXT_PUBLIC_ENABLE_OAUTH=false
NEXT_PUBLIC_USE_DEV_SESSION=false

# Local QA only — never set against a production build
# NEXT_PUBLIC_CUSTOMER_MASTER_OTP=

# Analytics (GTM / GA4), Insider's website tag, Tabby / Tamara promos and Google Maps
# are NOT set here (ADR-005 phase E): they come from the backend per website address,
# from the integrations switchboard (admin → Settings → Integrations). The build check
# (npm run check:brand) refuses the old NEXT_PUBLIC_GTM_ID / _GA4_ID / _INSIDER_* /
# _TABBY_* / _ENABLE_TABBY / _ENABLE_TAMARA / _ENABLE_PAYMOB / _GOOGLE_MAPS_* settings.
#
# Server-only (not NEXT_PUBLIC): the backend signs "refresh this address's settings"
# calls with it (backend SITE_REVALIDATE_SECRET, same value, ≥ 32 characters).
# Unset = those calls are refused and pages pick up changes within 5 minutes.
# SITE_REVALIDATE_SECRET=

# Optional override for relative catalog images (`/catalog/media/...`).
# Leave empty → falls back to apiBaseUrl.
# NEXT_PUBLIC_CATALOG_MEDIA_BASE_URL=

# Brand layer (Sapil). Host only — no scheme, path, or port.
# Local: set host override; live window hostname wins when not loopback.
# NEXT_PUBLIC_STOREFRONT_HOST=sapil-website.vercel.app
# NEXT_PUBLIC_STOREFRONT_BRAND_CODE=SAPIL

# OpenAPI codegen (build script, not browser)
# OPENAPI_SPEC_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io/api/docs-json

# Search engines index the site only when this is true AND NEXT_PUBLIC_APP_ENV=production.
# Keep false until go-live.
NEXT_PUBLIC_SEO_INDEXING_ENABLED=false
