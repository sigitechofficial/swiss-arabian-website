# Swiss Arabian storefront — local env
# Copy to .env.local and fill in values.

# --- Environment: read when the server runs (src/lib/config/runtime.ts) ---
# local | dev | staging | production. A built server without it refuses to start.
APP_ENV=local
# The backend, for server-side calls and for forwarding the browser's
# /storefront and /catalog calls (the browser only calls its own address).
API_BASE_URL=http://127.0.0.1:3000
# Search engines: production only, at go-live.
SEO_INDEXING_ENABLED=false
# Local only (APP_ENV=local; any other environment refuses to start with them).
# The backend only serves addresses in its address table (Brands -> Domains), and
# localhost is not one, so without these every page is "Not found" locally.
# STOREFRONT_HOST: the shop a plain http://localhost:3004 stands for.
# LOCAL_STOREFRONTS: <alias>=<BRAND_CODE>@<registered host>, comma-separated;
#   http://<alias>.localhost:3004 then stands for that shop (sp.localhost -> sapil.test).
# Each host must be an active domain of an active brand in the backend:
#   uae.swissarabian.com is created by the backend migrations (Swiss Arabian);
#   sapil.test is added in the admin (Brands -> Domains, brand SAPIL active) — see the
#   backend README "Fresh environment".
# A Sapil build (NEXT_PUBLIC_STOREFRONT_BRAND_CODE=SAPIL) uses STOREFRONT_HOST=sapil.test.
STOREFRONT_HOST=uae.swissarabian.com
LOCAL_STOREFRONTS=sa=SWISS_ARABIAN@uae.swissarabian.com,sp=SAPIL@sapil.test
# Staging / production only: the Front Door profile id(s) (src/lib/site/edge.ts)
# and the shared page cache (cache-handler.cjs). Both required there.
# TRUSTED_EDGE_IDS=
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# REDIS_TLS=

# --- Build: the brand (its design is compiled in) ---
NEXT_PUBLIC_STOREFRONT_BRAND_CODE=SWISS_ARABIAN

# Feature flags
NEXT_PUBLIC_ENABLE_MFA=false
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true
NEXT_PUBLIC_USE_DEV_SESSION=false

# Local QA only — never set against a production build
# NEXT_PUBLIC_CUSTOMER_MASTER_OTP=

# Analytics (GTM / GA4), Insider's website tag, Tabby / Tamara promos and Google Maps
# are NOT set here (ADR-005 phase E): they come from the backend per website address,
# from the integrations switchboard (admin → Settings → Integrations). The build check
# (npm run check:brand) refuses the old NEXT_PUBLIC_GTM_ID / _GA4_ID / _INSIDER_* /
# _TABBY_* / _TAMARA_PUBLIC_KEY / _ENABLE_TABBY / _ENABLE_TAMARA / _ENABLE_PAYMOB / _GOOGLE_MAPS_* settings.
#
# Server-only (not NEXT_PUBLIC): the backend signs "refresh this address's settings"
# calls with it (backend SITE_REVALIDATE_SECRET, same value, ≥ 32 characters).
# Unset = those calls are refused and pages pick up changes within 5 minutes.
# SITE_REVALIDATE_SECRET=

# OpenAPI codegen (build script, not browser)
# OPENAPI_SPEC_URL=https://ca-swissarabian-backend-dev.greenbush-d5b07575.uaenorth.azurecontainerapps.io/api/docs-json
