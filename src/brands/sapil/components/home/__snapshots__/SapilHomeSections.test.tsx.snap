  "social: <div class="flex items-end justify-between gap-[24px] mb-[40px] flex-wrap"><div><p class="font-sapil-sans font-[600] text-[12px] leading-[1.2] tracking-[.14em] uppercase text-sapil-muted mt-[12px] mb-[14px] !text-sapil-ink-2 max-w-[46ch]">Sapil on Instagram</p><p id="_r_" role="heading" aria-level="2" class="text-[clamp(34px,4.2vw,56px)] sapil-h">Watch the <span class="font-sapil-serif italic font-[400]">reels.</span></p></div><div class="flex gap-[16px] items-center flex-wrap"><a href="https://www.instagram.com/swissarabian/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-[8px] h-[48px] px-[24px] rounded-full font-[600] text-[15px] [transition:background_.18s_var(--sapil-ease),color_.18s_var(--sapil-ease),transform_.18s_var(--sapil-ease),box-shadow_.18s_var(--sapil-ease)] active:[transform:scale(.97)] disabled:opacity-50 disabled:cursor-not-allowed bg-sapil-accent text-sapil-white hover:bg-sapil-accent-2 [&amp;_svg]:w-[18px] [&amp;_svg]:h-[18px]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".8" fill="currentColor"></circle></svg>Follow us</a><div class="flex gap-[8px] [&amp;_svg]:rtl:[transform:scaleX(-1)]"><button type="button" aria-label="Previous reel" class="relative w-[44px] h-[44px] grid place-items-center rounded-full [transition:background_.18s] [&amp;_svg]:w-[22px] [&amp;_svg]:h-[22px] border border-sapil-line-2 bg-sapil-card disabled:opacity-[.35] disabled:cursor-default"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" stroke-width="1.6"><path d="m14.5 6-6 6 6 6"></path></svg></button><button type="button" aria-label="Next reel" class="relative w-[44px] h-[44px] grid place-items-center rounded-full [transition:background_.18s] [&amp;_svg]:w-[22px] [&amp;_svg]:h-[22px] border border-sapil-line-2 bg-sapil-card disabled:opacity-[.35] disabled:cursor-default"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" stroke-width="1.6"><path d="m9.5 6 6 6-6 6"></path></svg></button></div></div></div>",
  "about: <div class="w-full max-w-sapil-wrap mx-auto px-sapil-gut grid grid-cols-[minmax(0,6fr)_minmax(0,5fr)] gap-[72px] items-center max-900:grid-cols-1 max-900:gap-[40px]"><div class="relative aspect-[5/6] rounded-[24px] overflow-hidden"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 900px) 100vw, 55vw" srcset="/_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fsapil.com%2Fcdn%2Fshop%2Ffiles%2Fabout.jpg&amp;w=3840&amp;q=75"></div><div><p class="font-sapil-sans font-[600] text-[12px] leading-[1.2] tracking-[.14em] uppercase text-sapil-muted">About Sapil</p><p id="_r_" role="heading" aria-level="2" class="sapil-h text-[clamp(38px,4.4vw,60px)] mt-[14px] mb-[24px]">Fragrance made to be worn every day.</p><p class="text-sapil-ink-2 text-[17px] mb-[16px] max-w-[52ch]">Sapil was created to make fine fragrance part of everyday life.</p><div class="grid grid-cols-3 gap-[24px] my-[36px] pt-[28px] border-t border-sapil-line"><div><b class="block font-sapil-serif font-[400] text-[40px] leading-[1] mb-[6px] max-900:text-[32px]">80+</b><span class="text-[14px] text-sapil-muted">countries</span></div></div></div></div>",
]
`;

exports[`SapilHomeSections > with no CMS heading copy renders today's built-in heads, unchanged 2`] = `"<div><p class="font-sapil-sans font-[600] text-[12px] leading-[1.2] tracking-[.14em] uppercase text-sapil-muted">Now playing</p><p class="font-sapil-display text-[clamp(48px,5.6vw,92px)] leading-[.98] tracking-[-.01em] mt-[16px] mb-[18px] [text-wrap:balance] max-900:text-[46px]">Made to be <span class="font-sapil-serif italic">worn every day.</span></p><p class="text-[17px] text-sapil-ink-2 max-w-[40ch] mb-[28px]">Watch the films, then shop the bottles in them.</p><div class="flex gap-[10px] flex-wrap"><a class="inline-flex items-center justify-center gap-[8px] h-[48px] px-[24px] rounded-full font-[600] text-[15px] [transition:background_.18s_var(--sapil-ease),color_.18s_var(--sapil-ease),transform_.18s_var(--sapil-ease),box-shadow_.18s_var(--sapil-ease)] active:[transform:scale(.97)] disabled:opacity-50 disabled:cursor-not-allowed bg-sapil-accent text-sapil-white hover:bg-sapil-accent-2" href="/products">Shop new in</a></div></div>"`;
